# exo-agent-stack configuration. Copy to .env (make bootstrap does this). Never put a credential here.
# Every listener binds 127.0.0.1; there is no setting to change that.

# --- State and paths --------------------------------------------------------------------------
# Directory for stack.db, the local token (0600) and logs.
EXOS_STATE_DIR=.exos-state
# --root passed to `exo run --serve`.
EXOS_EXO_ROOT=.exos-state/exo
# The unmodified Claude Code binary used by Mode A (never the interactive shell wrapper).
EXOS_CLAUDE_BIN=claude
# Comma-separated absolute paths a delegated workspace must live under.
EXOS_ALLOWED_WORKSPACE_ROOTS=
# Tool-name globs (comma-separated) that only the dashboard may approve.
EXOS_APPROVE_DASHBOARD_ONLY=claude.Bash(git push:*),claude.Bash(npm publish:*)

# --- Ports (BUILD.md §6; loopback only) ---------------------------------------------------------
EXOS_DASHBOARD_PORT=9800
EXOS_EXO_PORT=9810
EXOS_BRIDGE_PORT=9811
EXOS_STACKD_PORT=9812
EXOS_FAKE_MODEL_PORT=9840
EXOS_WIREMOCK_PORT=9841

# --- Listen address -----------------------------------------------------------------------------
# Loopback only. Services refuse anything else. The value "container" is accepted solely inside
# the Docker images (EXOS_IN_CONTAINER=1), where compose publishes 127.0.0.1:<port> only.
EXOS_LISTEN_HOST=127.0.0.1
EXOS_IN_CONTAINER=0
# Base URL of Exo's HTTP API as seen by stackd (WireMock in the default compose stack).
EXOS_EXO_URL=http://127.0.0.1:9810/exo

# --- Compose and demo ----------------------------------------------------------------------------
# Containers run as this user so the bind-mounted .exos-state/compose stays writable (Makefile sets
# them from `id` when unset).
EXOS_UID=
EXOS_GID=
# Where `make demo` finds the local token written by the compose stackd.
EXOS_DEMO_STATE_DIR=.exos-state/compose

# --- Local access token -------------------------------------------------------------------------
# Left empty on purpose: stackd generates $EXOS_STATE_DIR/local-token (0600) on first start and the
# bridge and CLI read it from there. Only export it in your shell for Cursor's MCP config.
EXOS_LOCAL_TOKEN=

# --- Credit guard (subscription credit metered at API-rate equivalents) -------------------------
EXOS_MONTHLY_CREDIT_USD=20
EXOS_CURSOR_MONTHLY_BUDGET_USD=20
EXOS_CREDIT_CYCLE_DAY=1
EXOS_CREDIT_TZ=UTC
EXOS_CREDIT_WARN_RATIO=0.70
EXOS_CREDIT_STOP_RATIO=0.95
EXOS_CREDIT_CANCEL_ACTIVE=false
EXOS_METER_INTERVAL_SECONDS=15

# --- Concurrency and recovery -------------------------------------------------------------------
EXOS_MAX_ACTIVE_TURNS=4
EXOS_RECOVERY_MAX_ATTEMPTS=3

# --- Optional integrations ----------------------------------------------------------------------
# Read-only agent-fleet MCP endpoint rendered into ops-slack when set (loopback only).
EXOS_FLEET_MCP_URL=

# --- Tests (set by the test runner, listed so the example stays complete) -----------------------
# Ledger file written by the scripted harness's ledger_append tool.
EXOS_TEST_LEDGER=

# --- Live runs (maintainer only, never in CI) ---------------------------------------------------
# `make live-claude`, `make live-cursor` and `make eval-live` exit 2 unless this is set to the
# word that confirms a live run AND CI is not "true". Leave empty here.
EXOS_LIVE_CONFIRM=
# Hard cap enforced through the meter for `make eval-live`.
LIVE_EVAL_BUDGET_USD=2
